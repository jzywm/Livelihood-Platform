# AICORE 环境变量模板 · 复制为 .env 后填写真实值（.env 已被 .gitignore 覆盖）
# 占位符一律使用 your_ 前缀：仓库 pre-commit 的凭据扫描会豁免该前缀，
# 避免模板本身被误判为「疑似硬编码凭据」而阻断提交。
AICORE_APP_NAME=aicore
AICORE_ENV=dev
AICORE_LOG_LEVEL=INFO

# 数据库（独立库 aicore；本机测试库 aicore_test）
AICORE_MYSQL_HOST=127.0.0.1
AICORE_MYSQL_PORT=3306
AICORE_MYSQL_USER=your_db_user
AICORE_MYSQL_PASSWORD=your_db_password
AICORE_MYSQL_DATABASE=aicore

# MySQL 连接池（**必填**：容量是部署决策，刻意不给默认值——给默认值等于替运维做决定，
# 且「以为配了其实没配」的后果是连接耗尽，表现为请求排队而不是一条配置错误）
AICORE_MYSQL_POOL_SIZE=5
AICORE_MYSQL_MAX_OVERFLOW=10

# 只读（从库）地址（**可空**：不配置本项 = None = 没有独立从库，只读会话回落主库，
# 回落事实由 AICORE 的启动自检日志与 Settings.read_target_is_primary 显式暴露）。
# 本机单实例演练环境**没有从库**：请把下面两行**整行删掉**，而不要写成空值——
# 空串是「配了但配错了」，会被启动校验当成字段级错误拒绝（回落只认「不配置」）。
# 为什么可空项也必须写在模板里：test_env_example_matches_field_names_one_to_one
# 强制模板与字段表一一对应，缺一行模板就会不可用。
AICORE_MYSQL_READONLY_HOST=your_readonly_host
AICORE_MYSQL_READONLY_PORT=3306

# Redis（第 4 组起使用）
AICORE_REDIS_HOST=127.0.0.1
AICORE_REDIS_PORT=6379
AICORE_REDIS_DB=0

# 模型通道：mock | deepseek | cloud_vision | cloud_ocr
AICORE_PROVIDER=mock
AICORE_DEEPSEEK_API_KEY=your_deepseek_api_key

# 服务端间内部凭据（请求头 X-Internal-Token，不允许为空）
AICORE_INTERNAL_TOKEN=your_internal_token

# 配额与预算护栏（**必填**：缺失即拒绝启动，刻意不给默认值）
AICORE_DAILY_QUOTA_PER_ACCOUNT=1000
AICORE_DAILY_BUDGET_TOTAL=100000
# 预算阈值（占总额比例：0 < alert < 1，0 < degrade ≤ 1 且 degrade ≥ alert）
AICORE_BUDGET_ALERT_RATIO=0.8
AICORE_BUDGET_DEGRADE_RATIO=1.0

# 并发 / 租约 / 重试护栏
AICORE_CONCURRENCY_LIMIT=4
AICORE_LEASE_MS=30000
AICORE_MAX_RETRIES=3
