# 入口 Nginx 样例:LB → GATEWAY 双实例(平台唯一统一入口,网关为唯一鉴权点)
#
# 关键约定:
#   1. 上游只指向网关(不直连应用):网关是唯一鉴权点,直连应用 = 绕过鉴权;
#   2. /gateway/** 运维接口不对外暴露(仅内网探测),此处显式 404;
#   3. X-Forwarded-For 用 $proxy_add_x_forwarded_for 追加真实客户端 IP 到链尾
#      (网关取链尾作为客户端 IP,防伪造);TLS 在本层终结;
#   4. 网关全实例不可用时返回 503(LB 层快速失败),不做「直连单体」降级;
#   5. **Host 必须透传(默认必需),X-Forwarded-Host 建议同时带上(备案/双保险)**:
#      网关 acc 路由已启用 `PreserveHostHeader`(裁定 R-A16),把入口传来的原始 `Host` 原样转给 ACC;
#      ACC 侧「同源默认放行」据此推断浏览器看到的 host(host 部分不再依赖 X-Forwarded-Host)。
#      - `proxy_set_header Host $host;`                          ← 默认链路的关键行(不要改成 upstream 名);
#      - `proxy_set_header X-Forwarded-Host $host;`             ← 备案:链路中再多一跳/换入口代理时的兜底,
#        R-A16 之前它是必需项(真机演练已验证 SCG 会把入口传入的值原样转发给 ACC),保留即双保险;
#      - `proxy_set_header X-Forwarded-Proto $scheme;`          ← HTTPS 入口必需:scheme 无法由 Host 推断
#        (TLS 在本层终结,浏览器是 https 而网关到 ACC 是明文 http)。
#      (真机实测:入口只透传 Host + 同源 Origin → 换发 200;跨站 Origin → 401 + 2001 且不轮换。)

upstream gateway_cluster {
    # M1 初期双实例;生产按实例清单替换
    server gateway-a:8081 max_fails=2 fail_timeout=5s;
    server gateway-b:8081 max_fails=2 fail_timeout=5s;
    keepalive 64;
}

server {
    listen 80;
    server_name api.example.com;

    # 运维接口仅内网可达:对外入口一律 404(网关侧另有 gateway.ops.allowed-networks 兜底)
    location /gateway/ {
        return 404;
    }

    # 灰度分流(M1 初期):按 header/cookie/百分比把流量导向灰度实例组
    # (网关侧 metadata.weight 已预留,M1 后期改为网关路由权重)
    location /api/ {
        proxy_pass http://gateway_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 见文件头约定 5:HTTPS 入口必需(scheme 不能由 Host 推断)
        proxy_set_header X-Forwarded-Proto $scheme;
        # 见文件头约定 5:备案/双保险——默认链路已由网关保留原始 Host(R-A16),本行保留以兼容多跳代理
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 1s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        # 网关自身快速失败(503)时保留其响应,便于前端展示统一错误
        proxy_next_upstream error timeout http_502 http_503;
        proxy_intercept_errors off;
    }
}
