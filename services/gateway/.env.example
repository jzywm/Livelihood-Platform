# 网关服务运行所需环境变量(生产经 KMS 注入,密钥不出网关;勿提交真实值)
GATEWAY_JWT_SECRET=changeme-placeholder-secret
GATEWAY_STORE=redis
# 令牌策略(双 token;2026-09-15 定档):网关只认短 token(access,默认 15 分钟),
# exp 超过 access-token-max-ttl + clock-skew 即 401+2001;长 token(refresh,7 天)存 Cookie 且不经网关业务链路
GATEWAY_ACCESS_TOKEN_MAX_TTL=15m
GATEWAY_CLOCK_SKEW=60s
# 路由目标(部署环境覆盖;测试/多环境用)
GATEWAY_ACC_URI=http://acc:8080
# 运维标识(health 返回;双实例部署时区分)
GATEWAY_VERSION=0.1.0-SNAPSHOT
GATEWAY_INSTANCE_ID=gateway-a
# Redis(仅 GATEWAY_STORE=redis 需要;开 AUTH 时填 <username>/<password>)
GATEWAY_REDIS_HOST=redis
GATEWAY_REDIS_PORT=6379
GATEWAY_REDIS_USERNAME=
GATEWAY_REDIS_PASSWORD=
