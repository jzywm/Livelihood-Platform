{
  "name": "minsheng-zhenxuan",
  "version": "0.1.0",
  "private": true,
  "description": "民生甄选 · 民生综合服务平台 monorepo",
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "dev:pc": "pnpm --filter @minsheng/pc dev",
    "dev:pc:electron": "pnpm --filter @minsheng/pc electron:dev",
    "build:pc": "pnpm --filter @minsheng/pc build",
    "dev:mobile": "pnpm --filter @minsheng/mobile dev:h5",
    "dev:mobile:mp-weixin": "pnpm --filter @minsheng/mobile dev:mp-weixin",
    "build:mobile": "pnpm --filter @minsheng/mobile build:h5",
    "build:mobile:mp-weixin": "pnpm --filter @minsheng/mobile build:mp-weixin"
  }
}
